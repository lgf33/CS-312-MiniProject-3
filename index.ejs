<!DOCTYPE html>
<html lang="en">
<head>
<title>Luke Flaker's Blog</title>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- style sheet and bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head> 

<body>
<div class="container mt-5">

    <!-- display title and current user signed in-->
     <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="title mb-5">Luke Flaker's Blog</h1>
        <div>
            <span class="me-2">User: <%= user.name %></span>
            <!-- log out button-->
            <a href="/logout" class="btn btn-primary">Log Out</a>
        </div>
     </div>
    

    <h2>Create post:</h2>

    <!-- blog form -->
    <form action="/posts" method="POST">
        <div class="mb-3">
            <label class="form-label" >Title:</label>
            <input type="text" name="title" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label" >Blog:</label>
            <textarea type="text" name="content" class="form-control" rows="6" required></textarea>
        </div>
        

        <button type="submit" class="btn btn-primary">Make post</button>
    </form>

    <h2 class="mt-4 mb-3">Blogs Created:</h2>  

    <% posts.forEach(post => { %>
        <article class="card mb-4">
            <div class="card-body">
                <!-- post the content -->
                <h4 class="card-title"><%= post.title %></h4>
                <p class="card-text"><%= post.body %></p>
                <p class="text-muted">Author: <%= post.creator_name %></p>
                <p class="text-muted"><%= post.date %></p>
                
                <!-- only show edit and delete button for posts belonging to user-->
                <% if (post.creator_user_name === user.user_name) { %>
                    <!-- edit button -->
                    <a href="/posts/<%= post.blog_id%>/edit" class="btn btn-primary">Edit</a>

                    <!-- delete button -->
                    <form action="/posts/<%= post.blog_id %>/delete" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                <% } %>
            </div>

        </article>

    <% }) %>
</div>
</body>
</html>